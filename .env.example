SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://support:support@db:5432/support
INITIAL_ADMIN_EMAIL=admin@support.local
INITIAL_ADMIN_PASSWORD=ChangeMe123!
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_THINK=true
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_EMBEDDING_BASE_URL=http://ollama-embed:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EXTRA_EMBEDDING_MODELS=bge-m3 qwen3-embedding:4b
OLLAMA_EMBED_CPUS=3
OLLAMA_EXTRA_MODELS=qwen3:4b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
RAG_COLLECTION=support_documents
RAG_EMBEDDING_DIMENSION=1024
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Longueur maximale d'une réponse Anthropic, en jetons.
ANTHROPIC_MAX_TOKENS=4096
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
VITE_API_BASE=/api
MAX_ATTACHMENT_SIZE=10485760
MAX_ATTACHMENTS_PER_UPLOAD=5

# --- Enrichissement par la KB constructeur (optionnel) ---
# Démarrer le navigateur avec : docker compose --profile kb up -d
ENABLE_KB_BROWSER_SCRAPER=false
KB_BROWSER_TOKEN=remplacez-par-un-jeton-aleatoire
KB_BROWSER_VNC_PASSWORD=remplacez-par-un-mot-de-passe
KB_BASE_URL=https://kb.exemple.invalid/
# Sélecteurs CSS du portail (à adapter) :
# KB_SEARCH_INPUT_SELECTOR=input[type='search']
# KB_RESULT_LINK_SELECTOR=a.search-result
# KB_ARTICLE_SELECTOR=article
RAG_MAX_FILE_SIZE=52428800
RAG_MAX_FILES_PER_UPLOAD=50
KB_DOCS_ENABLED=false
# KB_DOCS_URL=https://myportal.al-enterprise.com/s/pre-sales-documents
# KB_DOCS_MAX_RESULTS=2
# Archive locale des éléments KB (dossier kb_archive/, hors Docker) :
KB_ARCHIVE_ENABLED=true
KB_ARCHIVE_MAX_MB=2048
# Documents propres à chaque entreprise (privés) :
COMPANY_DOCS_MAX_FILE_MB=10
COMPANY_DOCS_MAX_FILES_PER_UPLOAD=5
COMPANY_DOCS_MAX_MB_PER_COMPANY=500
# Console d'aide : recherche web libre via SearXNG auto-hébergé (vide : désactivée).
WEB_SEARCH_URL=
WEB_SEARCH_MAX_RESULTS=5
HELP_HISTORY_MESSAGES=12
